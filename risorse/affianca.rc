#include <windows.h>
101 ICON "affianca.ico"
1 RT_MANIFEST "affianca.manifest"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Window tiling for Windows 10"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "SnapTile"
            VALUE "OriginalFilename", "SnapTile.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 Raffaele Mele"
            VALUE "ProductName", "SnapTile"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
