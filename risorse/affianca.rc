#include <windows.h>
#include "versione.h"
101 ICON "affianca.ico"
1 RT_MANIFEST "affianca.manifest"
1 VERSIONINFO
FILEVERSION SNAPTILE_VERSIONE_FILE
PRODUCTVERSION SNAPTILE_VERSIONE_FILE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Window tiling for Windows 10"
            VALUE "FileVersion", SNAPTILE_VERSIONE
            VALUE "InternalName", "SnapTile"
            VALUE "OriginalFilename", "SnapTile.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 Raffaele Mele"
            VALUE "ProductName", "SnapTile"
            VALUE "ProductVersion", SNAPTILE_VERSIONE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
